# ---------------------------------------------------------------------------
# Copy to .env for docker compose. Every value here is optional and has a
# working default.
#
# Deliberately absent: delays, jitter, per-run budgets, schedule windows, retry
# limits, per-account toggles. Those live in the `settings` and `accounts` tables
# and are edited from the Web GUI, so tuning the scraper never means editing a
# file or restarting a container.
# ---------------------------------------------------------------------------

# --- Where the media lives --------------------------------------------------
# Bind-mounted into both the backend and the scraper. Point this at a NAS mount
# or an external drive if ./archive is not where you want tens of gigabytes to
# accumulate. Files stay raw and directly browsable either way.
ARCHIVE_HOST_PATH=./archive

# Subfolder names inside each account directory. Renaming these does not move
# existing folders; the scanner simply stops recognising the old ones.
PHOTOS_DIR=photos
VIDEOS_DIR=videos

# Anything smaller is almost always a placeholder or a truncated download rather
# than media worth indexing.
MIN_MEDIA_BYTES=1024

# --- Ports ------------------------------------------------------------------
WEB_PORT=3000
BACKEND_PORT=8000

# Only consulted if you point a browser directly at the backend port. Through
# the Next proxy the requests are same-origin and this is unused.
CORS_ORIGINS=http://localhost:3000

# --- Scraper deployment -----------------------------------------------------
# Leave WORKER_ID unset to get hostname plus a random suffix. Set it only if you
# want a stable name in the dashboard's worker list, and never set it if you run
# more than one replica.
WORKER_ID=

# How often the idle worker looks for work.
POLL_INTERVAL_SECONDS=10

# Job lease length. Must comfortably exceed the slowest single-file download plus
# its pacing delay, or a healthy worker gets its own job reaped out from under it.
LEASE_SECONDS=1800

REQUEST_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO

# --- Stealth and resilience hooks -------------------------------------------
# Comma-separated proxy URLs, rotated per job. Empty means a direct connection.
# Rotation also has to be switched on in the GUI (scraper.proxy_rotation).
SCRAPER_PROXIES=

# Cookie jars are read from COOKIE_DIR inside the container, which is the
# `archive-data` volume. Drop a Netscape cookies.txt in there per provider to
# give the authenticated adapters something to work with.

# --- Development / offline testing ------------------------------------------
# Serve from a local fixture tree instead of the network. This exercises the real
# discovery, hashing, dedup and pacing path with no outbound traffic at all.
SCRAPER_FIXTURE_DIR=

# Plan and log every download decision without writing a single byte.
SCRAPER_DRY_RUN=
